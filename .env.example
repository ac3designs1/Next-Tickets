# ─────────────────────────────────────────────────────────
#  TICKET BOT — Environment Variables
# ─────────────────────────────────────────────────────────
#
# IMPORTANT — ticket persistence
# Tickets are saved under DATA_DIR (default ./data) as tickets.json.
# On every host/panel/Docker restart, that folder MUST survive or the bot
# has to rebuild from Discord channel names (ticket-* = open, closed-* = closed).
#
# Recommended: set DATA_DIR to a persistent volume path, e.g.:
#   DATA_DIR=/home/container/ticket-data
#


# Persistent folder for tickets.json / applications.json / ticket-bans.json (optional but recommended)
# DATA_DIR=/home/container/ticket-data

# Your bot token from https://discord.com/developers/applications
BOT_TOKEN=your_bot_token_here

# Your bot's Application (Client) ID
CLIENT_ID=your_client_id_here

# ── Server IDs ──────────────────────────────────────────
# The PUBLIC server where users click the button / run /ticket to open tickets
MAIN_GUILD_ID=your_main_public_server_id

# The SEPARATE STAFF-ONLY server where ticket channels are automatically created
# This is a completely different Discord server — only staff should be in here
STAFF_GUILD_ID=your_staff_only_server_id

# ── Staff Role IDs (in the STAFF server) ────────────────
# The catch-all staff role that can see ALL unassigned tickets
# (before a ticket is transferred to a specific department)
DEFAULT_STAFF_ROLE_ID=your_general_staff_role_id

# ── Channel / Category ──────────────────────────────────
# Name of the category in the staff server where ticket channels are grouped
# Will be created automatically if it doesn't exist
TICKET_CATEGORY_NAME=Tickets

# ── Staff Applications ───────────────────────────────────
# Channel in the STAFF server where submitted applications are posted (management-only)
APPLICATIONS_CHANNEL_ID=1527645538244100136

# Channel in the MAIN server where the "Apply for Staff" panel button is posted
# The bot will auto-post a panel here on startup (leave blank to skip auto-post)
APPLICATIONS_PANEL_CHANNEL_ID=your_applications_panel_channel_id

# Role ID that can accept / decline applications (defaults to management role if blank)
APPLICATIONS_ROLE_ID=1515309451727470794
